{
  "manifest_version": 3,
  "name": "ja-live-subs · 实时日语字幕",
  "version": "0.4.2",
  "description": "本地 SenseVoice 识别日语，DeepSeek 翻译，在网页上叠加实时双语字幕。",
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "unlimitedStorage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.deepseek.com/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "实时字幕" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["caption-settings.js", "caption-overlay.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
